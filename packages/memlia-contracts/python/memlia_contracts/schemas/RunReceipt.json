{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "memlia.run-receipt/v1"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recordedAt": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        {
          "pattern": "^(?!0000)[0-9TZ:.-]+(?![\\s\\S])"
        }
      ]
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "awaiting_local_consent",
                "running",
                "awaiting_intervention",
                "stop_requested"
              ]
            },
            "effect": {
              "type": "string",
              "enum": [
                "none",
                "known",
                "unknown"
              ]
            },
            "evidence": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                  }
                },
                "required": [
                  "artifactId",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "effect",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "succeeded_verified"
            },
            "effect": {
              "type": "string",
              "const": "known"
            },
            "evidence": {
              "minItems": 1,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                  }
                },
                "required": [
                  "artifactId",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "verifierId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "status",
            "effect",
            "evidence",
            "verifierId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "failed",
                "stopped"
              ]
            },
            "effect": {
              "type": "string",
              "enum": [
                "none",
                "known"
              ]
            },
            "evidence": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                  }
                },
                "required": [
                  "artifactId",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "reasonCode": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
            }
          },
          "required": [
            "status",
            "effect",
            "evidence",
            "reasonCode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "cancelled_before_start"
            },
            "effect": {
              "type": "string",
              "const": "none"
            },
            "evidence": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                  }
                },
                "required": [
                  "artifactId",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "effect",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "uncertain"
            },
            "effect": {
              "type": "string",
              "const": "unknown"
            },
            "reconciliationRequired": {
              "type": "boolean",
              "const": true
            },
            "evidence": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
                  }
                },
                "required": [
                  "artifactId",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "effect",
            "reconciliationRequired",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "organizationId",
    "workspaceId",
    "runId",
    "commandId",
    "sequence",
    "recordedAt",
    "outcome"
  ],
  "additionalProperties": false
}
