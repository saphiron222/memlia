{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "memlia.snapshot/v1"
    },
    "organizationId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
    },
    "workbookId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
    },
    "workbookVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
    },
    "source": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "artifactId",
        "sha256"
      ],
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    },
    "capturedAt": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        {
          "pattern": "^(?!0000)[0-9TZ:.-]+(?![\\s\\S])"
        }
      ]
    },
    "accessMode": {
      "type": "string",
      "enum": [
        "owned_copy",
        "qualified_single_user",
        "read_only"
      ]
    },
    "readSet": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sheetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
          },
          "startRow": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "endRow": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "startColumn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "endColumn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          }
        },
        "required": [
          "sheetId",
          "startRow",
          "endRow",
          "startColumn",
          "endColumn"
        ],
        "additionalProperties": false
      }
    },
    "writeSet": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sheetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
          },
          "startRow": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "endRow": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "startColumn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "endColumn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          }
        },
        "required": [
          "sheetId",
          "startRow",
          "endRow",
          "startColumn",
          "endColumn"
        ],
        "additionalProperties": false
      }
    },
    "cells": {
      "maxItems": 2000000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sheetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
          },
          "row": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "column": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "value": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "null"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "decimal"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]{0,37})(?:\\.[0-9]{1,18})?(?![\\s\\S])"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "string"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[^\\uD800-\\uDFFF]{0,32767}(?![\\s\\S])",
                    "minLength": 0,
                    "maxLength": 32767
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "boolean"
                  },
                  "value": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "date"
                  },
                  "value": {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                      },
                      {
                        "pattern": "^(?!0000)[0-9-]+(?![\\s\\S])"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          },
          "formula": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "function": {
                    "type": "string",
                    "enum": [
                      "SUM",
                      "ROUND",
                      "IF",
                      "MIN",
                      "MAX",
                      "COUNT"
                    ]
                  },
                  "arguments": {
                    "minItems": 1,
                    "maxItems": 256,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "cell"
                            },
                            "reference": {
                              "type": "object",
                              "properties": {
                                "sheetId": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
                                },
                                "row": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 1048576
                                },
                                "column": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 16384
                                }
                              },
                              "required": [
                                "sheetId",
                                "row",
                                "column"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "kind",
                            "reference"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "range"
                            },
                            "reference": {
                              "type": "object",
                              "properties": {
                                "sheetId": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
                                },
                                "startRow": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 1048576
                                },
                                "endRow": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 1048576
                                },
                                "startColumn": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 16384
                                },
                                "endColumn": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 16384
                                }
                              },
                              "required": [
                                "sheetId",
                                "startRow",
                                "endRow",
                                "startColumn",
                                "endColumn"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "kind",
                            "reference"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "literal"
                            },
                            "value": {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "null"
                                    }
                                  },
                                  "required": [
                                    "kind"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "decimal"
                                    },
                                    "value": {
                                      "type": "string",
                                      "pattern": "^-?(?:0|[1-9][0-9]{0,37})(?:\\.[0-9]{1,18})?(?![\\s\\S])"
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "value"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "string"
                                    },
                                    "value": {
                                      "type": "string",
                                      "pattern": "^[^\\uD800-\\uDFFF]{0,32767}(?![\\s\\S])",
                                      "minLength": 0,
                                      "maxLength": 32767
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "value"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "boolean"
                                    },
                                    "value": {
                                      "type": "boolean"
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "value"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "date"
                                    },
                                    "value": {
                                      "type": "string",
                                      "allOf": [
                                        {
                                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                                        },
                                        {
                                          "pattern": "^(?!0000)[0-9-]+(?![\\s\\S])"
                                        }
                                      ]
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "value"
                                  ],
                                  "additionalProperties": false
                                }
                              ]
                            }
                          },
                          "required": [
                            "kind",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "function",
                  "arguments"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "styleHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "sheetId",
          "row",
          "column",
          "value",
          "formula",
          "styleHash"
        ],
        "additionalProperties": false
      }
    },
    "objectsDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])"
    }
  },
  "required": [
    "schemaVersion",
    "organizationId",
    "workspaceId",
    "snapshotId",
    "workbookId",
    "workbookVersion",
    "source",
    "digest",
    "capturedAt",
    "accessMode",
    "readSet",
    "writeSet",
    "cells",
    "objectsDigest"
  ],
  "additionalProperties": false
}
