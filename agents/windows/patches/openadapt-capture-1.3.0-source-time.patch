+# Modified by Memlia: source-time retention regression tests (MIT, see LICENSE).
+
+
+class SourceTimeRetentionTests(unittest.TestCase):
+    """Real observer methods, doubled Win32 hooks; never capture a desktop."""
+
+    def fixture(self, keyboard=True, mouse=True):
+        class SourceObserver(WindowsInputObserver):
+            def _retain_keyboard(self, **transition):
+                return keyboard
+
+            def _retain_mouse(self, **transition):
+                return mouse
+
+        api = SimpleNamespace(CallNextHookEx=lambda *args: 73,
+                              GetForegroundWindow=lambda: 91,
+                              GetWindowThreadProcessId=lambda *args: 17,
+                              GetKeyboardLayout=lambda *args: 1)
+        def unicode(vk, scan, state, buffer, limit, flags, layout):
+            buffer[0] = 'A' if state[0x10] & 0x80 else 'a'
+            return 1
+        api.ToUnicodeEx = unicode
+        observer = SourceObserver(lambda event: None, observe_keyboard=True,
+                                  observe_mouse=True, capture_mouse_moves=True,
+                                  _user32=api, _kernel32=SimpleNamespace())
+        queued, receipts = [], []
+        observer._enqueue_input = queued.append
+        observer._reserve_receipt = lambda timestamp: receipts.append(timestamp) or object()
+        return observer, queued, receipts
+
+    def key(self, observer, vk=65, pressed=True):
+        payload = KBDLLHOOKSTRUCT(vkCode=vk, scanCode=1, flags=0)
+        return observer._keyboard_hook_callback(HC_ACTION, 0x100 if pressed else 0x101,
+                                                ctypes.addressof(payload))
+
+    def mouse(self, observer):
+        payload = MSLLHOOKSTRUCT(pt=POINT(10, 20), flags=0)
+        return observer._mouse_hook_callback(HC_ACTION, WM_LBUTTONDOWN,
+                                             ctypes.addressof(payload))
+
+    def translate(self, observer, transitions):
+        emitted = []
+        observer._emit_received = lambda event, receipt: emitted.append(event)
+        for item in transitions:
+            observer._translation_queue.put_nowait(item)
+        observer._translation_stop_requested.set()
+        observer._input_translation_main()
+        return emitted
+
+    def test_suppressed_keys_never_reserve_or_emit_but_still_mark_native_activity(self):
+        observer, queued, receipts = self.fixture(keyboard=False)
+        self.assertEqual(self.key(observer), 73)
+        self.assertEqual(receipts, [])
+        self.assertEqual(observer._input_receipt_count, 1)
+        self.assertEqual(observer._native_callback_generation, 2)
+        self.assertEqual(len(queued), 1)
+        self.assertFalse(queued[0].retained)
+        self.assertIsNone(queued[0].receipt)
+        self.assertEqual(self.translate(observer, queued), [])
+        observer.check_health()
+
+    def test_suppressed_mouse_never_reserves_or_emits(self):
+        observer, queued, receipts = self.fixture(mouse=False)
+        self.assertEqual(self.mouse(observer), 73)
+        self.assertEqual(receipts, [])
+        self.assertEqual(observer._input_receipt_count, 1)
+        self.assertEqual(self.translate(observer, queued), [])
+        observer.check_health()
+
+    def test_suppression_preserves_modifier_state_for_other_inputs_and_release(self):
+        observer, queued, receipts = self.fixture(keyboard=False)
+        self.key(observer, 0xA0)  # suppressed left Shift down
+        observer._retain_keyboard = lambda **event: True
+        self.key(observer, 65)
+        observer._retain_keyboard = lambda **event: False
+        self.key(observer, 0xA0, False)
+        self.assertEqual(len(receipts), 1)
+        events = self.translate(observer, queued)
+        self.assertEqual([e.key_char for e in events], ['A'])
+        self.assertEqual(observer._keyboard_state[0x10], 0)
+        observer.check_health()
+
+    def test_unknown_policy_result_fails_before_receipt_and_still_calls_next_hook(self):
+        for result in (None, 0, 1, 'retain'):
+            for kind in ('keyboard', 'mouse'):
+                with self.subTest(result=result, kind=kind):
+                    observer, queued, receipts = self.fixture(keyboard=result, mouse=result)
+                    self.assertEqual(self.key(observer) if kind == 'keyboard' else self.mouse(observer), 73)
+                    self.assertEqual(receipts, [])
+                    self.assertEqual(queued, [])
+                    with self.assertRaises(InputObserverError):
+                        observer.check_health()
+
+    def test_policy_exception_fails_before_receipt(self):
+        observer, queued, receipts = self.fixture()
+        def refuses(**event):
+            raise InputObserverError('source policy unavailable')
+        observer._retain_mouse = refuses
+        self.assertEqual(self.mouse(observer), 73)
+        self.assertEqual(receipts, [])
+        self.assertEqual(queued, [])
+        with self.assertRaises(InputObserverError):
+            observer.check_health()
+
+    def test_default_retention_does_not_drop_native_events(self):
+        observer, queued, receipts = self.fixture()
+        observer._retain_keyboard = WindowsInputObserver._retain_keyboard.__get__(observer)
+        observer._retain_mouse = WindowsInputObserver._retain_mouse.__get__(observer)
+        self.key(observer)
+        self.mouse(observer)
+        self.assertEqual(len(receipts), 2)
+        self.assertTrue(all(item.retained for item in queued))
+        self.assertEqual(len(self.translate(observer, queued)), 2)
+        observer.check_health()
+
+    def test_suppressed_input_owns_no_journal_position_and_later_events_do_not_block(self):
+        observer, queued, receipts = self.fixture(keyboard=False, mouse=False)
+        journal = recorder_module.OrderedEventJournal()
+        observer._reserve_receipt = journal.reserve
+        self.key(observer)
+        self.key(observer, pressed=False)
+        self.mouse(observer)
+        self.assertIsNone(journal.last_source_ordinal)
+        observer._retain_keyboard = lambda **event: True
+        self.key(observer, 66)
+        self.key(observer, 66, False)
+        self.assertEqual(journal.last_source_ordinal, 2)
+        observer._emit_received = lambda event, receipt: receipt.complete(
+            recorder_module.Event(event.timestamp, 'action', 'fictitious'))
+        for item in queued:
+            observer._translation_queue.put_nowait(item)
+        observer._translation_stop_requested.set()
+        observer._input_translation_main()
+        observer.check_health()
+        self.assertEqual([journal.get_nowait().source_ordinal for _ in range(2)], [1, 2])
+        self.assertTrue(journal.empty())
