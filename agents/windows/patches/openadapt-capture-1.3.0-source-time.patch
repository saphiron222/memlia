+# Modified by Memlia: factory propagation contract tests (MIT, see LICENSE).
+
+
+class SourceTimeFactoryTests(unittest.TestCase):
+    """Native reader function; no Recorder startup or synthetic consent."""
+
+    def read(self, factory=None, explicit=False):
+        terminate, started = threading.Event(), threading.Event()
+        calls = []
+        class Observer:
+            def start(self):
+                terminate.set()
+            def check_health(self):
+                pass
+            def stop(self):
+                calls.append('stopped')
+        def create(callback, **kwargs):
+            calls.append(kwargs)
+            return Observer()
+        params = dict(input_observer_factory=create if factory is None else factory) if explicit else {}
+        with patch.object(recorder_module, 'create_input_observer', create):
+            recorder_module.read_input_events(queue.Queue(), terminate, object(), started, **params)
+        self.assertTrue(started.is_set())
+        self.assertEqual(calls, [dict(observe_keyboard=True, observe_mouse=True,
+                                     capture_mouse_moves=True), 'stopped'])
+
+    def test_injected_factory_is_used_with_the_exact_native_observer_contract(self):
+        self.read(explicit=True)
+
+    def test_default_factory_keeps_the_native_contract(self):
+        self.read()
+
+    def test_unknown_factory_fails_closed_instead_of_using_native_fallback(self):
+        for value in (False, 0, 'observer'):
+            with self.subTest(value=value):
+                with self.assertRaises(TypeError):
+                    self.read(factory=value, explicit=True)
+
+    def test_factory_is_passed_through_recorder_record_and_reader_without_serialization(self):
+        source = ast.parse(Path(recorder_module.__file__).read_text())
+        recorder = next(n for n in source.body if isinstance(n, ast.ClassDef) and n.name == 'Recorder')
+        init = next(n for n in recorder.body if isinstance(n, ast.FunctionDef) and n.name == '__init__')
+        self.assertIn('input_observer_factory', [arg.arg for arg in init.args.kwonlyargs])
+        self.assertTrue(any(isinstance(n, ast.Assign) and
+                            any(isinstance(t, ast.Attribute) and t.attr == '_input_observer_factory'
+                                for t in n.targets) and isinstance(n.value, ast.Name)
+                            and n.value.id == 'input_observer_factory' for n in ast.walk(init)))
+        run = next(n for n in recorder.body if isinstance(n, ast.FunctionDef) and n.name == '_run_record')
+        self.assertTrue(any(isinstance(n, ast.keyword) and n.arg == 'input_observer_factory'
+                            and isinstance(n.value, ast.Attribute) and
+                            n.value.attr == '_input_observer_factory' for n in ast.walk(run)))
+        record = next(n for n in source.body if isinstance(n, ast.FunctionDef) and n.name == 'record')
+        args = next(n for n in ast.walk(record) if isinstance(n, ast.Assign)
+                    and any(isinstance(t, ast.Name) and t.id == 'input_reader_args' for t in n.targets))
+        self.assertIsInstance(args.value.elts[-1], ast.Name)
+        self.assertEqual(args.value.elts[-1].id, 'input_observer_factory')
