# Copy to .env (ignored), chmod 600; never commit real values or rendered config.
# No usable secret or image digest is supplied. All four images must come from
# the SAME admitted Memlia release; they are not official Sim images.
MEMLIA_IMAGE_PREFIX=
MEMLIA_WEB_SHA256=
MEMLIA_REALTIME_SHA256=
MEMLIA_MIGRATIONS_SHA256=
MEMLIA_CRON_SHA256=
NEXT_PUBLIC_APP_URL=
# Absolute path in the Linux VM to a root-owned, non-secret Chat policy JSON.
# Use the schema in apps/sim/lib/memlia/ai/CHAT_POLICY.md. No active policy,
# model tariff or budget is invented by this template. Required even when Chat
# is not operational yet; absent/invalid/blocked policy refuses local Chat.
# File and container parents must pass the native reader's ownership/mode checks.
MEMLIA_CHAT_POLICY_SOURCE=

# Independent random secrets: openssl rand -hex 32 (do not rotate ENCRYPTION_KEY
# without migrating existing encrypted credentials and backing up the old key).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
INTERNAL_API_SECRET=
CRON_SECRET=

# Native Sim variables, URL-encode credentials. Database is db:5432/memlia.
# Use distinct provisioned web/realtime/schema-owner roles, never postgres for app.
# Role provisioning and grants are an integration gate; Compose does not create them.
DATABASE_URL=
DATABASE_URL_REALTIME=
MIGRATION_DATABASE_URL=

TRUSTED_ORIGINS=
AUTH_TRUSTED_PROXIES=
EGRESS_ALLOWED_HOSTS=
MAX_TOOL_ITERATIONS=20
EXECUTION_TIMEOUT_FREE=900
EXECUTION_TIMEOUT_ASYNC_FREE=900

# Configure providers later. Empty means unconfigured; never insert a fake active key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=
